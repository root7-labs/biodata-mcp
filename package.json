{
  "name": "biodata-mcp",
  "version": "0.1.1",
  "description": "MCP server that lets Claude, Cursor and other AI clients search PubMed, ClinicalTrials.gov, UniProt and Ensembl, with cited evidence packs.",
  "type": "module",
  "bin": {
    "biodata-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/tools.test.mjs test/protocol.test.mjs",
    "keys:init": "node scripts/keygen.mjs init",
    "keys:issue": "node scripts/keygen.mjs issue"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pubmed",
    "clinicaltrials",
    "uniprot",
    "ensembl",
    "bioinformatics",
    "biomedical",
    "claude"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Root 7 (Pty) Ltd <hello@root7.co.za>",
  "homepage": "https://github.com/root7-labs/biodata-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/root7-labs/biodata-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/root7-labs/biodata-mcp/issues",
    "email": "hello@root7.co.za"
  },
  "mcpName": "io.github.root7-labs/biodata-mcp",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
